# Load all libraries
library(Biostrings)
library(UniprotR)
library(protti)
library(r3dmol)
# Read your DNA fasta file
dna_seq <- readDNAStringSet("E_coli4.fasta")
# Translate DNA to protein
protein_seq <- translate(dna_seq)
library(Biostrings)
# Read fasta
dna_seq <- readDNAStringSet("E_coli4.fasta")
# Convert to uppercase
dna_seq <- toupper(dna_seq)
# Replace any invalid characters (keep only A, T, C, G)
dna_seq <- replaceLetterAt(dna_seq, which(!(dna_seq %in% c("A","T","C","G"))), "N")
library(Biostrings)
# Read fasta (still a DNAStringSet)
dna_seq <- readDNAStringSet("E_coli4.fasta")
# Convert each sequence to uppercase (still a DNAStringSet)
dna_seq <- DNAStringSet(toupper(as.character(dna_seq)))
# Replace any non-ATCG letters with N
clean_seq <- replaceAmbiguities(dna_seq, new="N")
# Translate cleaned DNA to protein
protein_seq <- translate(clean_seq)
library(Biostrings)
# Read fasta file
dna_seq <- readDNAStringSet("E_coli4.fasta")
# Convert to character vector (for cleaning)
dna_char <- as.character(dna_seq)
# Remove any non-ATCG letters
dna_clean <- gsub("[^ATCGatcg]", "N", dna_char)
# Convert back to DNAStringSet
dna_clean <- DNAStringSet(dna_clean)
# Translate cleaned DNA to protein
protein_seq <- translate(dna_clean)
library(Biostrings)
# Step 1: Read fasta
raw_fasta <- readLines("E_coli4.fasta")
# Step 2: Separate headers and sequences
headers <- raw_fasta[grepl("^>", raw_fasta)] # lines starting with >
seq_lines <- raw_fasta[!grepl("^>", raw_fasta)] # all other lines
# Step 3: Remove any non-ATCG letters from sequences
seq_clean <- toupper(gsub("[^ATCG]", "", seq_lines))
# Step 4: Combine sequences into single strings per sequence
# (In case your sequences are split across multiple lines in fasta)
library(dplyr)
seq_combined <- seq_clean %>% paste(collapse = "")
# Step 5: Make a DNAStringSet
dna_seq <- DNAStringSet(seq_combined)
names(dna_seq) <- headers
# Step 6: Translate DNA to protein
protein_seq <- translate(dna_seq)
# Step 7: Save protein fasta
writeXStringSet(protein_seq, "E_coli4_protein.fasta")
getwd()
list.files()
# Read the protein fasta you just wrote
protein_check <- readLines("E_coli4_protein.fasta")
head(protein_check)
accessions <- readLines("accessions.txt")
accessions <- as.character(accessions)
print(accessions)
# Your accession numbers
accessions <- c("A5TSU4", "A6P026", "A0ABQ5JST5", "A0A6L2ZY62", "A0A6L2ZY12")
# Make the FASTA URLs
urls <- paste0("https://www.uniprot.org/uniprot/", accessions, ".fasta")
# Print URLs to check
print(urls)
# Loop through each URL and download the sequence
for(i in 1:length(urls)) {
# Create a filename for saving
file_name <- paste0(accessions[i], ".fasta")
# Download the FASTA from UniProt and save it
download.file(urls[i], destfile = file_name, mode = "wb")
# Optional: print confirmation
cat("Downloaded:", file_name, "\n")
}
# Install Biostrings if you haven't yet
if(!requireNamespace("Biostrings", quietly = TRUE)) {
BiocManager::install("Biostrings")
}
library(Biostrings)
# Create a list to store sequences
seq_list <- list()
# Loop through each FASTA file and read it
for(i in 1:length(accessions)) {
file_name <- paste0(accessions[i], ".fasta")
# Read the FASTA sequence
seq_list[[accessions[i]]] <- readAAStringSet(file_name)
}
# Check the sequences
seq_list
# Get GO terms for your proteins
go_info <- GetProteinGOInfo(accessions)
# Check the results
head(go_info)
# Step 1: Set fallback accession numbers that have GO annotations
accessions <- c("P0A799", "P08839")
# Step 2: Make sure they are character strings
accessions <- as.character(accessions)
# Step 3: Create the URLs for UniProt FASTA files
urls <- paste0("https://www.uniprot.org/uniprot/", accessions, ".fasta")
# Step 4: Download the FASTA sequences
seq_list <- list()  # create an empty list to store sequences
for(i in 1:length(urls)) {
file_name <- paste0(accessions[i], ".fasta")
download.file(urls[i], destfile = file_name, mode = "wb")
# Read the FASTA sequence
seq_list[[accessions[i]]] <- Biostrings::readAAStringSet(file_name)
cat("Downloaded and read:", file_name, "\n")
}
# Step 5: Get GO information for these proteins
library(UniprotR)
go_info <- GetProteinGOInfo(accessions)
# Step 6: Check the results
head(go_info)
# Step 6: Plot GO term information
PlotGoInfo(go_info)
# Step 7: Save GO plot as a PNG
png("GO_plot.png", width = 1200, height = 800)   # adjust size as needed
PlotGoInfo(go_info, axis = "y")                  # axis="y" often makes it look better
# Step 7: Save separate GO term plots
png("GO_biological_process.png", width = 1000, height = 800)
PlotGoInfo(go_info, type = "biological_process")
PlotGoInfo(go_info)
# Save a publication‑quality GO term plot
PlotGOAll(
GOObj   = go_info,
Top     = 10,
directorypath = getwd(),   # Saves file into your project folder
width   = 8,
height  = 5
)
go_info
# Step 9: Get pathology and disease info
path_info <- GetPathology_Biotech(accessions)
disease_info <- Get.diseases(accessions)
# Extract disease information from the pathology results
disease_info <- Get.diseases(path_info)
# View results
disease_info
library(protti)
# Get UniProt information
uniprot_info <- fetch_uniprot(accessions)
# Look at the dataframe
View(uniprot_info)
# Check the PDB column
uniprot_info$xref_pdb
# Pull structural info from PDB
pdb_info <- fetch_pdb(c("1ZMR", "2HWG"))
# View the results
pdb_info
# Get AlphaFold structure predictions
af_info <- fetch_alphafold_prediction(accessions)
# View results
af_info
