seq1 <- readDNAStringSet("human_cytb.fasta")
seq2 <- readDNAStringSet("chimp_cytb.fasta")
seq3 <- readDNAStringSet("wolf_cytb.fasta")
seq4 <- readDNAStringSet("cat_cytb.fasta")
seq5 <- readDNAStringSet("cow_cytb.fasta")
View(seq3)
sequences <- c(seq1, seq2, seq3, seq4, seq5)
sequences
names(sequences) <- c(
"Human",
"Chimp",
"Wolf",
"Cat",
"Cow"
)
sequences
alignment <- msa(sequences, method = "Muscle")
print(alignment, show = "complete")
alignment <- msa(sequences, method = "Muscle")
alignment_matrix <- as.matrix(alignment)
gap_count <- sum(alignment_matrix == "-")
gap_count
# Tabulate the letters in your alignment
tab <- alphabetFrequency(alignment, as.prob=TRUE)  # proportion of each nucleotide
GC_content <- rowSums(tab[, c("G", "C")]) * 100   # %GC per sequence
GC_content
library(seqinr)
# Convert alignment from Biostrings to seqinr format
alignment_seqinr <- msaConvert(alignment, type="seqinr::alignment")
# Compute distance matrix
dist_matrix <- dist.alignment(alignment_seqinr, "identity")
dist_matrix
# Convert distance matrix to a standard R matrix
dist_matrix_r <- as.matrix(dist_matrix)
# Find the most closely and distantly related sequences
which(dist_matrix_r == max(dist_matrix_r), arr.ind=TRUE)  # most distant
which(dist_matrix_r == min(dist_matrix_r[dist_matrix_r > 0]), arr.ind=TRUE)  # most close
# Convert alignment to phangorn format
library(phangorn)
Alignment_phyDat <- msaConvert(alignment, type="phangorn::phyDat")
# Write to fasta
write.phyDat(Alignment_phyDat, "alignment.fasta", format="fasta")
# Convert alignment to phangorn format
library(phangorn)
Alignment_phyDat <- msaConvert(alignment, type="phangorn::phyDat")
# Write to fasta
write.phyDat(Alignment_phyDat, "alignment.fasta", format="fasta")
# Translate the human cytochrome b sequence
human_seq <- alignment[1]  # assuming human is first
# Convert your MSA to a DNAStringSet object (Biostrings format)
alignment_dna <- msaConvert(alignment, type="bios2mds::DNAStringSet")
# Extract the first sequence (Human) from the alignment as a character string
human_seq_char <- as.character(alignment@unmasked[[1]])
# Collapse it into a single string (it may be a vector of characters)
human_seq_str <- paste(human_seq_char, collapse="")
# Convert to DNAString object
library(Biostrings)
human_seq_DNA <- DNAString(human_seq_str)
# Translate to amino acids
human_seq_AA <- translate(human_seq_DNA)
