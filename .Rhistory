# ------------------------------------------------
# Lab 3 – Question 19 R Script
# ------------------------------------------------
# Step 0: Load required package
if (!requireNamespace("Biostrings", quietly = TRUE)) {
install.packages("BiocManager")
BiocManager::install("Biostrings")
}
library(Biostrings)
# ------------------------------------------------
# Step 1: Load your downloaded BLAST results
# Replace the path below with where your file actually is
# ------------------------------------------------
blast_seqs <- readDNAStringSet("C:/Lab3_R/Lab_3_Sequences.fasta")
# Print to confirm sequences loaded
print(blast_seqs)
# ------------------------------------------------
# Step 2: Assign query and first BLAST hit
# ------------------------------------------------
query_seq <- blast_seqs[[1]]        # your unknown sequence
subject_seq <- blast_seqs[[2]]      # first BLAST hit
# Print sequences
cat("\nQuery Sequence:\n")
query_seq
cat("\nSubject Sequence:\n")
subject_seq
# ------------------------------------------------
# Step 3: Calculate global percent identity manually
# ------------------------------------------------
# Convert sequences to character strings
query_letters <- as.character(query_seq)
subject_letters <- as.character(subject_seq)
# Trim longer sequence to match shorter one
min_len <- min(nchar(query_letters), nchar(subject_letters))
query_letters <- substr(query_letters, 1, min_len)
subject_letters <- substr(subject_letters, 1, min_len)
# Split into individual nucleotides
query_split <- strsplit(query_letters, "")[[1]]
subject_split <- strsplit(subject_letters, "")[[1]]
# Count matches
matches <- sum(query_split == subject_split)
# Calculate percent identity
percent_identity <- matches / min_len * 100
cat("\nPercent identity between query and first BLAST hit:", percent_identity, "%\n")
# ------------------------------------------------
# Step 4: Optional: Print a simple alignment view
# ------------------------------------------------
alignment_view <- paste0(
query_split,
"\n",
ifelse(query_split == subject_split, "|", " "),
"\n",
subject_split
)
cat("\nSimple Alignment View (first 50 nucleotides shown):\n")
cat(paste(alignment_view[1:50], collapse=" "), "\n")
