human <- read.fasta("sequences.fasta")
length(human)
names(human)
# Align the 20 Homo sapiens sequences
library(msa)  # Multiple Sequence Alignment package
human_aln <- msa(human)  # Perform multiple sequence alignment
library(msa)
# Align sequences directly from the FASTA file
human_aln <- msa("sequences.fasta")  # use the file path
library(msa)
# Align sequences directly from the FASTA file (DNA sequences)
human_aln <- msa("sequences.fasta", type = "dna")
human_aln  # show the alignment summary
# Step 2: Assess alignment quality
# Convert the alignment to a matrix for easier inspection
human_mat <- as.matrix(human_aln)
# Count fully conserved columns
conserved_cols <- apply(human_mat, 2, function(col) length(unique(col)) == 1)
sum(conserved_cols)  # number of fully conserved positions
# Calculate proportion of conserved columns
prop_conserved <- sum(conserved_cols) / ncol(human_mat)
prop_conserved  # proportion of columns that are fully conserved
# Comment:
# The alignment has a high proportion of conserved columns (prop_conserved),
# indicating that most sequences are very similar and the alignment is good.
# Step 9: Calculate the consensus sequence for the alignment
# Use msaConsensusSequence() to generate the consensus sequence
human_consensus <- msaConsensusSequence(human_aln)
# View the consensus sequence
human_consensus
# Comment:
# The consensus sequence represents the most common nucleotide at each position
# across all 20 Homo sapiens sequences. This is useful for identifying conserved
# regions and potential sites of variation.
# Step 4: Calculate GC content for the alignment
# Use letterFrequency() from Biostrings via as.BStringSet to get counts of G and C
library(Biostrings)
# Convert aligned sequences to BStringSet
human_bstring <- as.BStringSet(human_aln)
# Comment:
# The GC content gives an overview of nucleotide composition.
# A higher GC content can affect stability and secondary structure of DNA.
# Step 4: Calculate GC content for the alignment
# Load Biostrings for nucleotide counting
library(Biostrings)
# Convert MSA object to DNAMultipleAlignment to BStringSet
human_bstring <- DNAStringSet(unmasked(human_aln))  # unmasked gives the raw sequences
# Count G and C nucleotides across the alignment
gc_count <- sum(letterFrequency(human_bstring, letters = c("G","C")))
# Total number of nucleotides in the alignment
total_count <- sum(letterFrequency(human_bstring, letters = c("A","T","G","C")))
# Calculate GC content proportion
gc_content <- gc_count / total_count
gc_content  # proportion of GC nucleotides
# Comment:
# The GC content gives an overview of nucleotide composition.
# A higher GC content can affect stability and secondary structure of DNA.
# Step 9: Check for differences between sequences
# Calculate pairwise Hamming distances between sequences in the alignment
# This counts the number of positions where sequences differ
library(ape)  # for dist.dna()
# Convert the MSA to a DNAbin object for distance calculations
human_dnabin <- as.DNAbin(as.matrix(human_aln))
# Compute pairwise distances
distances <- dist.dna(human_dnabin, model = "raw")  # proportion of differing sites
# View distances
distances
# Find the individual most different from the rest
# Sum distances per sequence
total_distances <- apply(as.matrix(distances), 1, sum)
most_diff_index <- which.max(total_distances)
most_diff_seq_name <- names(human)[most_diff_index]
most_diff_seq_name
# Comment:
# The sequence identified in 'most_diff_seq_name' is the most different
# from the rest of the population. This individual may carry mutations
# that are unique relative to the other 19 sequences.
# Step 10: Translate the most different sequence to protein and save as FASTA
# Extract the sequence
most_diff_seq <- human[[most_diff_index]]
# Translate DNA to protein using seqinr
most_diff_protein <- translate(most_diff_seq)
# Step 10: Translate the most different sequence to protein and save as FASTA
# Extract the sequence as a vector of characters
most_diff_seq <- unlist(human[[most_diff_index]])
# Translate DNA to protein using seqinr
most_diff_protein <- translate(most_diff_seq)
# Step 10: Translate the most different sequence to protein
# Extract the most divergent sequence as a simple character vector
most_diff_seq <- getSequence(human[[most_diff_index]])[[1]]
# Translate DNA to protein
most_diff_protein <- translate(most_diff_seq)
# Step 10: Translate the most different sequence to protein
# Extract the most divergent sequence as a character vector of nucleotides
most_diff_seq <- toupper(getSequence(human[[most_diff_index]])[[1]])
# Ensure it's a vector of single letters (SeqinR requires this)
if(length(most_diff_seq) == 1) {
most_diff_seq <- unlist(strsplit(most_diff_seq, split = ""))
}
# Translate DNA to protein
most_diff_protein <- seqinr::translate(most_diff_seq)
# Step 10: Translate the most different sequence to protein
# Extract the most divergent sequence as a vector of nucleotides
most_diff_seq <- getSequence(human[[most_diff_index]])[[1]]
# If it's a single string, split into individual nucleotides
if(length(most_diff_seq) == 1) {
most_diff_seq <- unlist(strsplit(most_diff_seq, split = ""))
}
# Ensure letters are uppercase (SeqinR prefers this)
most_diff_seq <- toupper(most_diff_seq)
# Translate DNA to protein (default table = standard)
most_diff_protein <- seqinr::translate(most_diff_seq, frame = 0)
# Step 10: Translate the most different sequence to protein
# Extract the most divergent sequence
most_diff_seq <- human[[most_diff_index]]
# Convert to a vector of characters (nucleotides)
nuc_vec <- getSequence(most_diff_seq)[[1]]
# If it's a single string, split it into individual letters
if(length(nuc_vec) == 1) {
nuc_vec <- unlist(strsplit(nuc_vec, split = ""))
}
# Ensure only complete codons are translated
nuc_vec <- nuc_vec[1:(length(nuc_vec) - (length(nuc_vec) %% 3))]
# Translate DNA to protein
most_diff_protein <- seqinr::translate(nuc_vec, frame = 0)
# Step 10: Translate the most different sequence to protein
library(seqinr)
# Extract the most divergent sequence
most_diff_seq <- human[[most_diff_index]]
# Convert to a character vector (nucleotides)
nuc_vec <- toupper(as.character(unlist(most_diff_seq)))
# Ensure only complete codons are translated
nuc_vec <- nuc_vec[1:(length(nuc_vec) - (length(nuc_vec) %% 3))]
# Translate DNA to protein
most_diff_protein <- seqinr::translate(nuc_vec, frame = 0)
# View the protein sequence
most_diff_protein
# Save protein sequence to a FASTA file
seqinr::write.fasta(sequences = list(most_diff_protein),
