library(seqinr)
gene_alignment <- read.dna("metazoa_alignment.gene (1).fasta", format = "fasta")
hs_seq <- gene_alignment["Homo_sapiens", ]
hs_seq_char <- as.character(hs_seq)
hs_seq_no_gaps <- hs_seq_char[hs_seq_char != "-"]
hs_seq_vec <- s2c(paste(hs_seq_no_gaps, collapse = ""))
hs_protein <- seqinr::translate(hs_seq_vec)
write.fasta(sequences = list(hs_protein),
names = "Homo_sapiens_protein",
file.out = "Homo_sapiens_protein.fasta")
# After UniProt accession
library(seqinr)
hs_protein_seq <- paste(hs_protein, collapse = "")
write.fasta(sequences = list(hs_protein_seq),
names = "POLG_Homo_sapiens",
file.out = "Homo_sapiens_protein.fasta")
