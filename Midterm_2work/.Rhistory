library(seqinr)
most_diff_protein <- seqinr::translate(nuc_vec, frame = 0)
# 1️⃣ Grab the most divergent sequence from your DNAStringSet
most_diff_seq <- dna_sequences[[mostdiffindex]]  # DNAString object
# 2️⃣ Convert it to a plain character string
most_diff_seq_char <- as.character(most_diff_seq)  # now it's a single string of letters
# 3️⃣ Split into a vector of single nucleotides
nuc_vec <- strsplit(most_diff_seq_char, split = "")[[1]]
# 4️⃣ Make sure all letters are uppercase
nuc_vec <- toupper(nuc_vec)
# 5️⃣ Trim to full codons
nuc_vec <- nuc_vec[1:(length(nuc_vec) - (length(nuc_vec) %% 3))]
# 6️⃣ Translate to protein
most_diff_protein <- seqinr::translate(nuc_vec, frame = 0)
# 7️⃣ Check result
most_diff_protein
seqinr::write.fasta(
sequences = list(most_diff_protein),
names = "MostDivergentIndividual",
file.out = "mostdivergentprotein.fasta"
)
