install.packages(c("ape", "phangorn", "seqinr", "ggtree"))
library(ape)
library(phangorn)
library(seqinr)
library(ggtree)
alignment <- read.dna("metazoa_alignment.5k.fasta", format = "fasta")
list.files()
alignment <- read.dna("metazoa_alignment.5k (1).fasta", format = "fasta")
alignment
phydat <- phyDat(alignment, type = "DNA")
phydat
dist_matrix <- dist.ml(phydat)
dist_matrix
treeNJ <- NJ(dist_matrix)
plot(treeNJ, main = "Neighbor Joining Tree")
phydat <- phyDat(alignment, type = "DNA")
# Make a starting tree with NJ for ML optimization
start_tree <- NJ(dist_matrix)
plot(fitML$tree, main = "Maximum Likelihood Tree")
alignment <- read.dna("metazoa_alignment.5k (1).fasta", format = "fasta")
phydat <- phyDat(alignment, type = "DNA")
dist_matrix <- dist.ml(phydat)  # Calculate distance matrix
start_tree <- NJ(dist_matrix)    # Neighbor-Joining starting tree
dist_matrix <- dist.ml(phydat)  # Calculate distance matrix
start_tree <- NJ(dist_matrix)    # Neighbor-Joining starting tree
library(phangorn)
fit <- pml(start_tree, data = phydat)  # Fit starting tree
fitML <- optim.pml(fit, model = "HKY", optGamma = TRUE, rearrangement = "stochastic")  # Optimize ML tree
plot(fitML$tree, main = "Maximum Likelihood Tree", cex=0.7)
# Plot Maximum Likelihood tree with smaller tip labels
plot(fitML$tree, main = "Maximum Likelihood Tree", cex = 0.7)
# Root the ML tree using the Porifera as outgroup
rooted_tree <- root(fitML$tree, outgroup = c("Plakina_jani", "Grantia_compressa"), resolve.root = TRUE)
# Plot the rooted tree
plot(rooted_tree, main = "Rooted ML Tree", cex=0.7)
# Bootstrap with 100 replicates (can increase for more accuracy)
bs <- bootstrap.pml(fitML, bs = 100, optNni = TRUE)
# Plot tree with bootstrap values
plotBS(rooted_tree, bs, type="phylogram", cex=0.6)
# Example: Check if a clade is monophyletic
lophotrochozoa <- c("Cerebratulus_sp", "Leptochiton_rugatus")  # add all members
is.monophyletic(rooted_tree, lophotrochozoa)
# Save the rooted ML tree as PDF
pdf("Rooted_ML_tree.pdf", width=8, height=10)
plot(rooted_tree, main = "Rooted Maximum Likelihood Tree", cex=0.7)
dev.off()
